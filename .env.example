APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anavertuan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Gateway central de WhatsApp (evtu.com.br) ───────────────────────────────
# Liga (true) o envio de mensagens via gateway em vez da Graph API direta.
# Comece em false (código antigo) e ligue só após testar — rollback instantâneo.
WA_GATEWAY_ACTIVE=false
WHATSAPP_GATEWAY_URL=https://evtu.com.br
WHATSAPP_GATEWAY_KEY=
WHATSAPP_SYSTEM_SLUG=av

# ── Mercado Pago (Checkout Transparente) ─────────────────────────────────────
# Pegue em: painel MP → Suas integrações → Detalhes da aplicação → Credenciais.
# Use as de TESTE (TEST-...) em dev e as de PRODUÇÃO em produção. NUNCA suba os
# valores reais no git — este arquivo (.env.example) leva só placeholders.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Secret para validar o webhook (x-signature). Configure ao cadastrar a URL de
# notificação no painel do MP; vazio = não valida (fail-open, igual ao WhatsApp).
MP_WEBHOOK_SECRET=
MP_STATEMENT_DESCRIPTOR=Anavertuan
# Taxa estimada (%) de custos do MP no pior caso — cartão em 6x sem juros.
# Só alimenta a estimativa visual na criação da ordem. Ajuste ao seu plano real.
MP_TAXA_CREDITO_6X=14.94

# ── InfinitePay (Link de Pagamento / redirect) ───────────────────────────────
# Gateway ATUAL. API pública (sem credenciais): o lojista é identificado pelo
# HANDLE = seu InfiniteTag (no app InfinitePay) SEM o '$'. Ex.: se seu tag é
# $anavertuan, use INFINITEPAY_HANDLE=anavertuan.
# Habilite o "Checkout Integrado" no app/web da InfinitePay e configure o
# parcelamento (até 12x, sendo 6x sem juros) na CONTA antes do deploy.
INFINITEPAY_HANDLE=
# Segredo aleatório nosso (ex.: `openssl rand -hex 24`) embutido no PATH do
# webhook (server-to-server). A API de Link NÃO assina o webhook — este token é
# a 1ª camada de validação (a 2ª é confirmar via payment_check no controller).
INFINITEPAY_WEBHOOK_TOKEN=
# Placeholder de estimativa (%) do custo InfinitePay — a API não devolve o
# líquido real do lojista, então o "valor recebido" no dashboard é estimativa.
# Ajuste ao confirmar a taxa real com a CloudWalk.
INFINITEPAY_TAXA_CREDITO=4.99
# Templates de mensagem (WhatsApp Business) usados para notificar ordem criada
# e pagamento aprovado. Criar/aprovar no Gerenciador da Meta. Fora da janela de
# 24h a Meta só entrega mensagens iniciadas pela empresa se forem templates.
WHATSAPP_TEMPLATE_ORDEM_PAGAMENTO=ordem_pagamento_disponivel
WHATSAPP_TEMPLATE_PAGAMENTO_APROVADO=pagamento_confirmado
